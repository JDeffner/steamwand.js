{
  "name": "steamwand.js",
  "version": "0.3.0",
  "description": "TypeScript bindings for the Steamworks SDK, generated from steam_api.json over the flat C API via koffi FFI. No native compilation.",
  "license": "MIT",
  "author": "Joel Deffner",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "runtime",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "generate": "tsx scripts/generate.ts",
    "smoke": "tsx scripts/smoke.ts",
    "workbench": "tsx scripts/workbench.ts",
    "test": "vitest run",
    "test:live": "cross-env STEAM_LIVE=1 vitest run test/live",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JDeffner/steamwand.js.git"
  },
  "bugs": {
    "url": "https://github.com/JDeffner/steamwand.js/issues"
  },
  "homepage": "https://github.com/JDeffner/steamwand.js/wiki",
  "keywords": [
    "steam",
    "steamworks",
    "workshop",
    "ffi",
    "koffi",
    "typescript"
  ]
}
